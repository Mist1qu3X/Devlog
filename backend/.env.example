# PostgreSQL
# For hosted deployments, set DATABASE_URL instead of the DB_* variables.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=blog_db
DB_USER=postgres
DB_PASSWORD=password

# JWT
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App
APP_NAME=Blog API
APP_VERSION=1.0.0
DEBUG=False
